# FinteraUI environment variables (Vite embeds these at build time).
# Copy to `.env` and adjust for your environment.

# FinteraAPI origin including /api/v1.
VITE_API_URL=http://localhost:8081/api/v1
VITE_APP_ENV=development

# Public origin of the customer portal (FinteraWeb).
# Customers (role `user`) are redirected here after signing in, and the
# sign-up screen links here. Leave empty to fall back to the local 403 screen.
# Dev:     http://localhost:5173
# Staging: https://portal.staging.fintera.app
# Prod:    https://portal.fintera.app
VITE_CUSTOMER_PORTAL_URL=http://localhost:5173

# Optional: prefill the sign-in form in local development/staging.
# VITE_DEFAULT_EMAIL=
# VITE_DEFAULT_PASSWORD=

# Optional: Rollbar error tracking token.
# VITE_ROLLBAR_ACCESS_TOKEN=
